package main

import "fmt"

func main() {
	var n, m int
	fmt.Scan(&n, &m)
	arr := make([]int, n)
	for i := 0; i < n; i++ {
		fmt.Scan(&arr[i])
	}

	for i := 0; i < m; i++ {
		var a, b int
		fmt.Scan(&a, &b)
		maxNum, minNum := max(a, b)
		curr := arr[maxNum-1] + arr[minNum-1]
		arr[maxNum-1] = curr
		arr[minNum-1] = 0
	}
	for i := 0; i < n; i++ {
		if arr[i] != 0 {
			fmt.Printf("%s %s\n", i+1, arr[i])
		}
	}
}

func max(a, b int) int {
	if a > b {
		return a, b
	}
	return b, a
}
